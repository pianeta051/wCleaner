{
  "Description": "DDB Resource for AWS Amplify CLI",
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "partitionKeyName": {
      "Type": "String"
    },
    "partitionKeyType": {
      "Type": "String"
    },
    "env": {
      "Type": "String"
    },
    "sortKeyName": {
      "Type": "String"
    },
    "sortKeyType": {
      "Type": "String"
    },
    "tableName": {
      "Type": "String"
    }
  },
  "Conditions": {
    "ShouldNotCreateEnvResources": {
      "Fn::Equals": [
        {
          "Ref": "env"
        },
        "NONE"
      ]
    }
  },
  "Resources": {
    "DynamoDBTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "email",
            "AttributeType": "S"
          },
          {
            "AttributeName": "slug",
            "AttributeType": "S"
          },
          {
            "AttributeName": "job_start_time_pk",
            "AttributeType": "N"
          },
          {
            "AttributeName": "start",
            "AttributeType": "N"
          },
          {
            "AttributeName": "name_lowercase",
            "AttributeType": "S"
          },
          {
            "AttributeName": "color",
            "AttributeType": "S"
          },
          {
            "AttributeName": "job_type_id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "job_invoice_pk",
            "AttributeType": "N"
          },
          {
            "AttributeName": "invoice_date",
            "AttributeType": "N"
          },
          {
            "AttributeName": "invoice_number",
            "AttributeType": "N"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "customer_email",
            "KeySchema": [
              {
                "AttributeName": "email",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "customer_slug",
            "KeySchema": [
              {
                "AttributeName": "slug",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "job_start_time",
            "KeySchema": [
              {
                "AttributeName": "job_start_time_pk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "start",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "job_type_name",
            "KeySchema": [
              {
                "AttributeName": "name_lowercase",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "job_type_color",
            "KeySchema": [
              {
                "AttributeName": "color",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "job_type_id",
            "KeySchema": [
              {
                "AttributeName": "job_type_id",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "invoice_date",
            "KeySchema": [
              {
                "AttributeName": "job_invoice_pk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "invoice_date",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "invoice_number",
            "KeySchema": [
              {
                "AttributeName": "job_invoice_pk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "invoice_number",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        },
        "TableName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            {
              "Ref": "tableName"
            },
            {
              "Fn::Join": [
                "",
                [
                  {
                    "Ref": "tableName"
                  },
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Name": {
      "Value": {
        "Ref": "DynamoDBTable"
      }
    },
    "Arn": {
      "Value": {
        "Fn::GetAtt": [
          "DynamoDBTable",
          "Arn"
        ]
      }
    },
    "StreamArn": {
      "Value": {
        "Fn::GetAtt": [
          "DynamoDBTable",
          "StreamArn"
        ]
      }
    },
    "PartitionKeyName": {
      "Value": {
        "Ref": "partitionKeyName"
      }
    },
    "PartitionKeyType": {
      "Value": {
        "Ref": "partitionKeyType"
      }
    },
    "SortKeyName": {
      "Value": {
        "Ref": "sortKeyName"
      }
    },
    "SortKeyType": {
      "Value": {
        "Ref": "sortKeyType"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    }
  }
}